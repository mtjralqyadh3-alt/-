<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Apax Security" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="فحص أمني وخزنة ملفات وواجهة Home اختيارية" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/accessStatus" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/storageButton" android:text="إدارة صلاحية الملفات من إعدادات Android" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/scanButton" android:text="فحص التطبيقات المثبتة الآن" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/scanStatus" android:text="لم يبدأ الفحص" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/scanResult" android:textIsSelectable="true" android:fontFamily="monospace" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/scanStorageButton" android:text="فحص الملفات غير الضرورية والكبيرة" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/storageScanStatus" android:text="لم يبدأ فحص الملفات" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/storageScanResult" android:textIsSelectable="true" android:fontFamily="monospace" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="الفحص المحلي فقط: لا يتم إرسال أي ملف أو بيانات خارج الهاتف." android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#777777" />
        <TextView android:text="الخزنة والآلة الحاسبة" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/calculatorInput" android:hint="2+2 أو الرمز السري" android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/unlockButton" android:text="= / فتح" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
            <Button android:id="@+id/clearButton" android:text="مسح" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/calculatorResult" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/vaultStatus" android:text="الخزنة مغلقة" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/importButton" android:enabled="false" android:text="اختيار ملف وتشفيره فعلياً" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="اضغط على ملف لاستعادته، واضغط مطولاً لحذفه" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ListView android:id="@+id/vaultList" android:dividerHeight="1dp" android:layout_width="match_parent" android:layout_height="220dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="#777777" />
        <TextView android:text="إخفاء التطبيقات من واجهة Apax Home" android:textSize="20sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="هذه الوظيفة تعمل عند اختيار Apax Home كتطبيق الشاشة الرئيسية الافتراضي. الإخفاء لا يحذف التطبيقات ولا يتحكم في Launcher آخر." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/launcherSettingsButton" android:text="اختيار Apax Home من إعدادات النظام" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
